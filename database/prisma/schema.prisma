datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String?
  createdAt    DateTime       @default(now())

  activities   Activity[]
  sessions     StudySession[]
  habits       Habit[]
  tasks        Task[]
  goals        Goal[]
  reviews      DailyReview[]
  settings     UserSettings?
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  theme               String   @default("dark")
  dailyTargetMinutes  Int      @default(360)
  workIntervalMinutes Int      @default(25)
  shortBreakMinutes   Int      @default(5)
  longBreakMinutes    Int      @default(15)
  soundEnabled        Boolean  @default(true)
  ambientSound        String   @default("none")

  user                User     @relation(fields: [userId], references: [id])
}

model Activity {
  id                 String         @id @default(uuid())
  userId             String
  name               String
  category           String
  color              String
  dailyTargetMinutes Int
  isActive           Boolean        @default(true)

  user               User           @relation(fields: [userId], references: [id])
  sessions           StudySession[]
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  activityId      String
  startTime       DateTime
  endTime         DateTime
  durationSeconds Int
  notes           String?
  date            String   // YYYY-MM-DD

  user            User     @relation(fields: [userId], references: [id])
  activity        Activity @relation(fields: [activityId], references: [id])
}

model Habit {
  id                String     @id @default(uuid())
  userId            String
  name              String
  category          String
  color             String
  frequency         String     @default("daily")
  targetDaysPerWeek Int        @default(7)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())

  user              User       @relation(fields: [userId], references: [id])
  logs              HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  date      String   // YYYY-MM-DD
  completed Boolean  @default(true)

  habit     Habit    @relation(fields: [habitId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    String    // 'LOW' | 'MEDIUM' | 'HIGH'
  category    String
  dueDate     String?   // YYYY-MM-DD
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  type         String   // 'TIME' | 'TASK' | 'HABIT' | 'DEADLINE'
  targetValue  Int
  currentValue Int      @default(0)
  targetDate   String?  // YYYY-MM-DD
  category     String
  color        String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

model CustomCountdown {
  id         String @id @default(uuid())
  title      String
  targetDate String // YYYY-MM-DD
  category   String
  color      String
  icon       String
}

model DailyReview {
  id                String @id @default(uuid())
  userId            String
  date              String // YYYY-MM-DD
  wentWell          String?
  improve           String?
  tomorrowFocus     String?
  productivityScore Int    @default(8)

  user              User   @relation(fields: [userId], references: [id])
}
